  "code_facts": {
    "harness_synth_channel_sample_L555_L564": {
      "file": "D:\\Code\\HD-QKD_Polar_Comparison\\comparison_bench\\src\\comparison_bench\\cli\\run_nonbinary_v32_finite_de_bridge.py",
      "lines": "555-564",
      "excerpt": "def synth_channel_sample(seed: int, p_ser: float) -> tuple[list[int], list[int]]:\n    \"\"\"Matched iid synthetic channel: uniform GF(1024) words, iid substitution\n    with probability ``p_ser`` (frozen V25 raw_ser), replacement delta uniform\n    in [1,1023] added modulo 1024.\"\"\"\n    rng = np.random.default_rng(seed)\n    alice = rng.integers(0, 1024, size=N_FROZEN, dtype=np.int64)\n    mask = rng.random(N_FROZEN) < float(p_ser)\n    deltas = rng.integers(1, 1024, size=N_FROZEN, dtype=np.int64)\n    bob = np.where(mask, (alice + deltas) % 1024, alice)\n    return alice.tolist(), bob.tolist()"
    },
    "nonbinary_v26_channel_semantics_L10_L13": {
      "file": "D:\\Code\\HD-QKD_Polar_Comparison\\comparison_bench\\src\\comparison_bench\\formal_ir\\nonbinary_v26_channel.py",
      "lines": "10-13",
      "excerpt": "Semantics (V26 design section 1):\n- ``(A,B)`` sampled from the train joint ``P(A,B)`` = N_ab / total.\n- L1: ``P(U1=u|B) = sum_{a: L1(a)=u} P(A=a|B)``.\n- L2: ``P(U2=u|B,U1) = sum_{a: L1(a)=U1,L2(a)=u} P(A=a|B) / sum_{a: L1(a)=U1} P(A=a|B)``."
    }
  },
